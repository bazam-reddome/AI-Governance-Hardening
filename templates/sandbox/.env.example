# Copy to .env and fill in.
APP_IMAGE=ghcr.io/[your-org]/[ai-built-app]:[sha-or-tag]

OIDC_ISSUER=https://[your-idp]/oauth2/default
OIDC_CLIENT_ID=[client-id]
OIDC_CLIENT_SECRET=[client-secret]
COOKIE_SECRET=[generate via: openssl rand -base64 32 | head -c 32]
ALLOWED_EMAIL_DOMAINS=[your-domain.com]

SIEM_WEBHOOK=https://siem.[your-domain].com/ingest/aigov-sandbox
